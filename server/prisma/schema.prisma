// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================================
// CORE BUSINESS MODELS
// ============================================================================

// Enums for better type safety
enum QuotationStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
  CANCELLED
}

enum ProductType {
  PRODUCT
  SERVICE
  SUBSCRIPTION
  BUNDLE
}

enum UserRole {
  ADMIN
  MANAGER
  SALES_REP
  VIEWER
  APPROVER
}

enum CommunicationType {
  EMAIL
  SMS
  PHONE
  MEETING
  NOTE
  SYSTEM
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  ESCALATED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  TIERED
  VOLUME
}

enum TaxType {
  INCLUSIVE
  EXCLUSIVE
  EXEMPT
}

enum DocumentType {
  QUOTATION
  PROPOSAL
  CONTRACT
  ATTACHMENT
  SIGNATURE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum IntegrationStatus {
  ACTIVE
  INACTIVE
  ERROR
  PENDING
}

enum IntegrationType {
  CRM
  ACCOUNTING
  EMAIL
  STORAGE
  COMMUNICATION
  ANALYTICS
}

model Client {
  id        String   @id @default(cuid())
  name      String
  contact   String
  email     String   @unique
  phone     String
  address   String
  city      String
  state     String
  zipCode   String
  country   String
  notes     String?

  // Enhanced CRM fields
  category        String?  // "premium", "standard", "basic"
  segment         String?  // "enterprise", "sme", "individual"
  creditLimit     Float?   @default(0)
  paymentTerms    Int?     @default(30) // days
  taxId           String?
  website         String?
  industry        String?
  companySize     String?
  preferredCurrency String? @default("USD")

  // Status and tracking
  status          String   @default("active") // "active", "inactive", "suspended"
  lastContactDate DateTime?
  nextFollowUp    DateTime?
  assignedTo      String?  // User ID
  leadSource      String?
  tags            String?  // JSON array of tags
  customFields    String?  // JSON object for custom fields

  // Additional CRM features
  parentClientId  String?  // For client hierarchies
  billingAddress  String?
  shippingAddress String?
  primaryContact  String?
  secondaryContact String?
  accountManager  String?
  riskLevel       String?  @default("low") // "low", "medium", "high"
  lifetimeValue   Float?   @default(0)
  acquisitionCost Float?   @default(0)
  satisfactionScore Int?   // 1-10 scale

  // Portal access
  portalEnabled   Boolean  @default(false)
  portalUsername  String?  @unique
  portalPassword  String?  // Hashed
  lastPortalLogin DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  quotations        Quotation[]
  communications    Communication[]
  pricingAgreements PricingAgreement[]
  approvals         QuotationApproval[]
  activities        ClientActivity[]
  documents         ClientDocument[]
  parentClient      Client?  @relation("ClientHierarchy", fields: [parentClientId], references: [id])
  childClients      Client[] @relation("ClientHierarchy")
  portalAccess      CustomerPortalAccess?

  @@map("clients")
}

model Product {
  id          String      @id @default(cuid())
  name        String
  description String
  type        String      // "PRODUCT", "SERVICE", or "SUBSCRIPTION"
  price       Float
  unit        String
  tax         Float       @default(0)
  stock       Int?
  image       String?

  // Enhanced product fields
  category        String?
  sku             String?  @unique
  specifications  String?  // JSON string for detailed specs
  images          String?  // JSON array of image URLs
  documents       String?  // JSON array of document URLs
  weight          Float?
  dimensions      String?  // "L x W x H"
  manufacturer    String?
  brand           String?
  model           String?
  warranty        String?

  // Pricing and inventory
  costPrice       Float?
  marginPercent   Float?   @default(0)
  taxable         Boolean  @default(true)
  taxCategory     String?  @default("standard")
  currency        String   @default("USD")
  inStock         Boolean  @default(true)
  stockLevel      Int      @default(0)
  minStock        Int      @default(0)

  // Status and tracking
  status          String   @default("active") // "active", "inactive", "discontinued"
  isService       Boolean  @default(false)
  isBundle        Boolean  @default(false)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relations
  quotationItems    QuotationItem[]
  pricingTiers      PricingTier[]
  bundleItems       BundleItem[] @relation("BundleProduct")
  bundleComponents  BundleItem[] @relation("ComponentProduct")

  @@map("products")
}

model Quotation {
  id         String          @id @default(cuid())
  clientId   String
  date       DateTime
  expiryDate DateTime
  subtotal   Float           @default(0)
  tax        Float           @default(0)
  discount   Float           @default(0)
  total      Float           @default(0)
  notes      String?
  terms      String?
  status     String          @default("DRAFT") // "DRAFT", "PENDING", "SENT", "APPROVED", "REJECTED"

  // Enhanced quotation fields
  referenceNumber   String    @unique
  version           Int       @default(1)
  parentQuotationId String?   // For version control
  templateId        String?
  currency          String    @default("USD")
  exchangeRate      Float     @default(1.0)

  // Workflow and approval
  approvalRequired  Boolean   @default(false)
  approvalStatus    String    @default("none") // "none", "pending", "approved", "rejected"
  approvedBy        String?
  approvedAt        DateTime?
  rejectionReason   String?

  // Communication and tracking
  sentAt            DateTime?
  viewedAt          DateTime?
  lastFollowUp      DateTime?
  nextFollowUp      DateTime?
  priority          String    @default("medium") // "low", "medium", "high", "urgent"

  // Analytics and conversion
  conversionStatus  String    @default("open") // "open", "won", "lost", "expired"
  winLossReason     String?
  competitorInfo    String?
  profitMargin      Float?

  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  // Relations
  client            Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  items             QuotationItem[]
  template          Template?           @relation(fields: [templateId], references: [id])
  parentQuotation   Quotation?          @relation("QuotationVersions", fields: [parentQuotationId], references: [id])
  childQuotations   Quotation[]         @relation("QuotationVersions")
  approvals         QuotationApproval[]
  communications    Communication[]
  activities        QuotationActivity[]
  documents         QuotationDocument[]

  @@map("quotations")
}

model QuotationItem {
  id          String  @id @default(cuid())
  quotationId String
  productId   String
  name        String
  description String
  quantity    Int
  unitPrice   Float
  tax         Float   @default(0)
  discount    Float   @default(0)
  total       Float

  // Relations
  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@map("quotation_items")
}

model Template {
  id          String   @id @default(cuid())
  name        String
  description String
  category    String
  content     String
  thumbnail   String?

  // Enhanced template fields
  type        String   @default("quotation") // "quotation", "terms", "email"
  isDefault   Boolean  @default(false)
  industry    String?
  language    String   @default("en")
  variables   String?  // JSON string of template variables

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  quotations  Quotation[]

  @@map("templates")
}

model DesktopItem {
  id        String   @id @default(cuid())
  name      String
  type      String   // "folder", "shortcut", "document", "app"
  icon      String
  positionX Float
  positionY Float
  target    String?  // For shortcuts
  content   String?  // For documents
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("desktop_items")
}

// Pricing and Bundle Management
model PricingTier {
  id        String   @id @default(cuid())
  productId String
  name      String   // "bulk", "volume", "customer-specific"
  minQty    Int
  maxQty    Int?
  price     Float
  discount  Float    @default(0)
  currency  String   @default("USD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("pricing_tiers")
}

model BundleItem {
  id              String   @id @default(cuid())
  bundleProductId String
  componentId     String
  quantity        Int      @default(1)
  discount        Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  bundleProduct Product   @relation("BundleProduct", fields: [bundleProductId], references: [id], onDelete: Cascade)
  component     Product   @relation("ComponentProduct", fields: [componentId], references: [id])

  @@map("bundle_items")
}

model PricingAgreement {
  id          String   @id @default(cuid())
  clientId    String
  productId   String?
  name        String
  description String?
  price       Float
  discount    Float    @default(0)
  validFrom   DateTime
  validTo     DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("pricing_agreements")
}

// Workflow and Approval Management
model QuotationApproval {
  id          String    @id @default(cuid())
  quotationId String
  approverId  String
  level       Int       @default(1)
  status      String    @default("pending") // "pending", "approved", "rejected"
  comments    String?
  approvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  approver  Client    @relation(fields: [approverId], references: [id])

  @@map("quotation_approvals")
}

model Communication {
  id          String   @id @default(cuid())
  quotationId String?
  clientId    String
  type        String   // "email", "sms", "call", "meeting", "note"
  subject     String?
  content     String
  direction   String   // "inbound", "outbound"
  status      String   @default("sent") // "draft", "sent", "delivered", "read", "failed"
  scheduledAt DateTime?
  sentAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  quotation Quotation? @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  client    Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("communications")
}

model QuotationActivity {
  id          String   @id @default(cuid())
  quotationId String
  userId      String?  // User who performed the action
  action      String   // "created", "updated", "sent", "viewed", "approved", "rejected"
  description String
  metadata    String?  // JSON string for additional data
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  // Relations
  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@map("quotation_activities")
}

model QuotationDocument {
  id          String   @id @default(cuid())
  quotationId String
  name        String
  type        String   // "pdf", "word", "excel", "image"
  url         String
  size        Int?     // File size in bytes
  version     Int      @default(1)
  isMain      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@map("quotation_documents")
}

// Advanced Features Models
model User {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String
  role        String   @default("user") // "admin", "manager", "user", "viewer"
  permissions String?  // JSON string of permissions
  department  String?
  isActive    Boolean  @default(true)
  lastLogin   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  notifications      Notification[]
  profile            UserProfile?
  roleAssignments    UserRoleAssignment[]

  @@map("users")
}

model Currency {
  id           String   @id @default(cuid())
  code         String   @unique // "USD", "EUR", "GBP"
  name         String   // "US Dollar"
  symbol       String   // "$"
  exchangeRate Float    @default(1.0)
  isDefault    Boolean  @default(false)
  isActive     Boolean  @default(true)
  lastUpdated  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("currencies")
}

model TaxRate {
  id          String   @id @default(cuid())
  name        String   // "VAT", "GST", "Sales Tax"
  rate        Float    // 0.20 for 20%
  type        String   @default("percentage") // "percentage", "fixed"
  country     String?
  region      String?
  category    String?  // "standard", "reduced", "zero"
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  validFrom   DateTime
  validTo     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("tax_rates")
}

model WorkflowTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  type        String   // "approval", "notification", "automation"
  conditions  String   // JSON string of conditions
  actions     String   // JSON string of actions
  isActive    Boolean  @default(true)
  priority    Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  workflows   Workflow[]

  @@map("workflow_templates")
}

model Workflow {
  id         String   @id @default(cuid())
  templateId String
  entityId   String   // quotation ID, client ID, etc.
  entityType String   // "quotation", "client", "product"
  status     String   @default("active") // "active", "completed", "cancelled"
  currentStep Int     @default(1)
  data       String?  // JSON string of workflow data
  startedAt  DateTime @default(now())
  completedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  template   WorkflowTemplate @relation(fields: [templateId], references: [id])
  steps      WorkflowStep[]

  @@map("workflows")
}

model WorkflowStep {
  id          String    @id @default(cuid())
  workflowId  String
  stepNumber  Int
  name        String
  type        String    // "approval", "notification", "automation"
  assigneeId  String?
  status      String    @default("pending") // "pending", "completed", "skipped"
  data        String?   // JSON string of step data
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  workflow    Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@map("workflow_steps")
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  type        String   // "approval", "reminder", "alert", "info"
  title       String
  message     String
  data        String?  // JSON string of notification data
  isRead      Boolean  @default(false)
  priority    String   @default("medium") // "low", "medium", "high", "urgent"
  scheduledAt DateTime?
  sentAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  entityType  String   // "quotation", "client", "product"
  entityId    String
  action      String   // "create", "update", "delete", "view", "send"
  oldValues   String?  // JSON string of old values
  newValues   String?  // JSON string of new values
  ipAddress   String?
  userAgent   String?
  timestamp   DateTime @default(now())

  @@map("audit_logs")
}

model Integration {
  id          String   @id @default(cuid())
  name        String   // "Salesforce", "QuickBooks", "Mailchimp"
  type        String   // "crm", "erp", "email", "accounting"
  config      String   // JSON string of configuration
  isActive    Boolean  @default(true)
  lastSync    DateTime?
  syncStatus  String   @default("idle") // "idle", "syncing", "error"
  errorLog    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("integrations")
}

model ClientActivity {
  id          String   @id @default(cuid())
  clientId    String
  userId      String?  // User who performed the action
  type        String   // "call", "email", "meeting", "note", "task"
  subject     String?
  description String
  outcome     String?
  nextAction  String?
  scheduledAt DateTime?
  completedAt DateTime?
  priority    String   @default("medium") // "low", "medium", "high"
  status      String   @default("completed") // "scheduled", "completed", "cancelled"
  metadata    String?  // JSON string for additional data
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("client_activities")
}

model ClientDocument {
  id          String   @id @default(cuid())
  clientId    String
  name        String
  type        String   // "contract", "agreement", "certificate", "other"
  category    String?
  url         String
  size        Int?     // File size in bytes
  mimeType    String?
  version     Int      @default(1)
  isConfidential Boolean @default(false)
  expiryDate  DateTime?
  uploadedBy  String?  // User ID
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("client_documents")
}

model Analytics {
  id          String   @id @default(cuid())
  type        String   // "conversion", "performance", "revenue"
  period      String   // "daily", "weekly", "monthly", "quarterly"
  date        DateTime
  data        String   // JSON string of analytics data
  createdAt   DateTime @default(now())

  @@map("analytics")
}

model CustomField {
  id          String   @id @default(cuid())
  entityType  String   // "quotation", "client", "product"
  name        String
  label       String
  type        String   // "text", "number", "date", "select", "checkbox"
  options     String?  // JSON string for select options
  isRequired  Boolean  @default(false)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("custom_fields")
}

model CustomFieldValue {
  id          String   @id @default(cuid())
  fieldId     String
  entityId    String
  value       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  field       CustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@map("custom_field_values")
}

// ============================================================================
// NEW FEATURE MODELS
// ============================================================================

// Customer Portal Models
model CustomerPortalAccess {
  id              String    @id @default(cuid())
  clientId        String    @unique
  username        String    @unique
  passwordHash    String
  isActive        Boolean   @default(true)
  lastLogin       DateTime?
  loginAttempts   Int       @default(0)
  lockedUntil     DateTime?
  resetToken      String?
  resetTokenExpiry DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  client          Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sessions        PortalSession[]

  @@map("customer_portal_access")
}

model PortalSession {
  id              String    @id @default(cuid())
  portalAccessId  String
  sessionToken    String    @unique
  ipAddress       String?
  userAgent       String?
  isActive        Boolean   @default(true)
  expiresAt       DateTime
  createdAt       DateTime  @default(now())

  // Relations
  portalAccess    CustomerPortalAccess @relation(fields: [portalAccessId], references: [id], onDelete: Cascade)

  @@map("portal_sessions")
}

// Financial Reports Models
model FinancialReport {
  id              String    @id @default(cuid())
  name            String
  type            String    // "revenue", "profit_loss", "expense", "forecast"
  period          String    // "monthly", "quarterly", "yearly"
  startDate       DateTime
  endDate         DateTime
  data            String    // JSON data for the report
  generatedBy     String?   // User ID
  isScheduled     Boolean   @default(false)
  scheduleConfig  String?   // JSON for schedule configuration
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("financial_reports")
}

model RevenueMetric {
  id              String    @id @default(cuid())
  date            DateTime
  totalRevenue    Float     @default(0)
  quotationCount  Int       @default(0)
  conversionRate  Float     @default(0)
  averageValue    Float     @default(0)
  currency        String    @default("USD")
  createdAt       DateTime  @default(now())

  @@map("revenue_metrics")
}

// User Management Models
model UserProfile {
  id              String    @id @default(cuid())
  userId          String    @unique
  firstName       String
  lastName        String
  avatar          String?
  phone           String?
  timezone        String    @default("UTC")
  language        String    @default("en")
  preferences     String?   // JSON preferences
  bio             String?
  socialLinks     String?   // JSON social media links
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

// System Integrations Models
model Integration {
  id              String    @id @default(cuid())
  name            String
  type            String    // "CRM", "ACCOUNTING", "EMAIL", "STORAGE"
  provider        String    // "salesforce", "hubspot", "quickbooks", etc.
  description     String?
  iconUrl         String?
  configSchema    String    // JSON schema for configuration
  isActive        Boolean   @default(true)
  isOfficial      Boolean   @default(false)
  version         String    @default("1.0.0")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  connections     IntegrationConnection[]

  @@map("integrations")
}

model IntegrationConnection {
  id              String    @id @default(cuid())
  integrationId   String
  name            String
  status          String    @default("PENDING") // "ACTIVE", "INACTIVE", "ERROR", "PENDING"
  config          String    // JSON configuration
  credentials     String?   // Encrypted credentials
  lastSync        DateTime?
  syncFrequency   String?   // "hourly", "daily", "weekly"
  errorMessage    String?
  isActive        Boolean   @default(true)
  createdBy       String?   // User ID
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  integration     Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  syncLogs        IntegrationSyncLog[]

  @@map("integration_connections")
}

model IntegrationSyncLog {
  id              String    @id @default(cuid())
  connectionId    String
  status          String    // "success", "error", "warning"
  recordsProcessed Int      @default(0)
  recordsSuccess  Int       @default(0)
  recordsError    Int       @default(0)
  errorDetails    String?   // JSON error details
  startedAt       DateTime
  completedAt     DateTime?
  duration        Int?      // Duration in milliseconds

  // Relations
  connection      IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@map("integration_sync_logs")
}

// Note: SQLite doesn't support enums, so we use strings instead
// ProductType: "PRODUCT", "SERVICE", "SUBSCRIPTION"
// QuotationStatus: "DRAFT", "PENDING", "SENT", "APPROVED", "REJECTED"
// DesktopItemType: "folder", "shortcut", "document", "app"
// CommunicationType: "email", "sms", "call", "meeting", "note"
// ApprovalStatus: "pending", "approved", "rejected"
// UserRole: "admin", "manager", "user", "viewer"
// WorkflowType: "approval", "notification", "automation"
// NotificationType: "approval", "reminder", "alert", "info"
